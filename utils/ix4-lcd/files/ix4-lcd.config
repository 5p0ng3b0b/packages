# Lenovo Iomega ix4-300d LCD configuration (/etc/config/ix4-lcd)
# Apply changes anytime with: /etc/init.d/ix4-lcd reload
#
# Rules:
#   - Define 1..16 'config page' sections; each supports 'row0'..'row7'.
#   - Set option hide '1' on any page to omit it from LCD display & cycling.
#   - Leave a row unset to keep that line blank.
#   - Wrap values in single quotes: option row2 'IP: {ip}'
#   - Max 255 chars per template; max 191 chars after expansion.
#   - Rows <= 21 chars stay static; rows > 21 chars auto-scroll horizontally.
#   - Display a 128x64 1-bit monochrome .bmp graphic on any page:
#       option bmp 'logo.bmp' (or '/etc/ix4-lcd/logo.bmp'; optional option bmp_invert '1')
#       option bmp_b64 '<base64 128x64 1-bit bmp>' (inline base64 BMP alternative)
#       Any row0..row7 set on the same page draws on top of the bitmap.
#   - Define up to 32 custom '{tokens}' via 'config token' sections:
#       option name 'my_tok'      (token name used as {my_tok}, max 23 chars)
#       option file '/sys/...'    (direct file read, zero fork; optional option div '1000')
#       option cmd  'shell cmd'   (runs via /bin/sh, uses first output line)
#       option ttl  '60'          (optional cache duration in seconds; 0=every refresh)
#
# Inline $(command) rules:
#   - Wrap the row value in single quotes: option row4 'Host: $(uname -n)'
#   - Max 255 chars per command; captures first output line only (max 127 chars).
#   - Do not use ')' inside $(...) (call a script if ')' is needed).
#   - Runs every 'refresh' seconds via 'timeout 2 sh -c'; keep commands fast.
#
# Built-in Header & Clock tokens:
#   {page} {auto} {date} {time} {time_sec} {uptime} {hostname} {kernel}
# Built-in System & Thermal tokens:
#   {ram} {load} {cpu_temp} {soc_temp} {board_temp} {bay_temp} {fan}
# Built-in Network tokens:
#   {ip} {eth0} {eth1} {eth0_ip} {eth1_ip} {eth0_speed} {eth1_speed} {rx_rate} {tx_rate}
# Built-in Storage & NAS tokens:
#   {sata} {raid} {flash} {mnt_used} {mnt_free} {hdd1_temp}..{hdd4_temp} {smb_clients}

config general 'general'
	option enabled '1'
	option default_page '1'     # 1-based startup page index (1..16, 1=Page 1)
	option backlight '3'        # 0=off, 1=96, 2=180, 3=255
	option invert '1'           # 1=positive (0xA7), 0=negative (0xA6)
	option contrast '38'        # 0..63 (ST7565 contrast)
	option refresh '5'          # stats refresh interval in seconds
	option auto_scroll '0'      # 1=auto-cycle pages on boot, 0=off
	option marquee_ms '400'     # smooth 1-char scroll step (ms) for >21-char rows
	option save_buttons '1'     # 1=persist front-panel button toggles via uci

config page
	option bmp 'logo.bmp'

config page
	option row0 '{hostname} {page}{auto}'
	option row2 'IP: {ip}'
	option row3 'Up: {uptime}'
	option row4 'RAM: {ram}'
	option row5 'CPU:{cpu_temp}C Fan:{fan}'
	option row7 '{date}       {time}'

config page
	option row0 'Storage & RAID  {page}{auto}'
	option row2 'SATA Bays: {sata}'
	option row4 'RAID: {raid}'
	option row6 'Flash: {flash}'

config page
	option row0 'Network & Load  {page}{auto}'
	option row2 'eth0:{eth0_speed} eth1:{eth1_speed}'
	option row3 'RX:{rx_rate} TX:{tx_rate}'
	option row5 'Load: {load}'
